{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamyar-heyat",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamyar-heyat-db",
      "database_id": "b94c96d1-191a-4c6f-b303-cde4860484f6"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_HUB", "class_name": "RoomHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomHub"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
