{
  "name": "hamyar-heyat",
  "version": "0.1.0",
  "private": true,
  "description": "Persian community communications PWA for Heyat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "member:add": "node scripts/add-member.js",
    "test": "npm run test:node && npm run test:worker",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc",
    "worker:preview": "wrangler preview --config wrangler.jsonc",
    "test:node": "node scripts/check-client.js && node --test tests/server.test.js",
    "test:worker": "vitest run --config vitest.config.mjs",
    "assets:embed": "node scripts/embed-assets.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "wrangler": "^4.165.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "vitest": "^4.1.0"
  }
}
